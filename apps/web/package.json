{
  "name": "@ocmc/web",
  "private": true,
  "scripts": {
    "dev": "HOSTNAME=${HOSTNAME:-0.0.0.0} PORT=${PORT:-3000} next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "start:local": "HOSTNAME=${HOSTNAME:-0.0.0.0} PORT=${PORT:-3099} node .next/standalone/apps/web/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ocmc/db": "workspace:*",
    "@ocmc/shared": "workspace:*",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
