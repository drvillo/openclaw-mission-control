{
  "name": "@ocmc/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "../../scripts/with-env.sh tsx watch src/index.ts",
    "start": "../../scripts/with-env.sh tsx src/index.ts",
    "backfill:assertion-associations": "../../scripts/with-env.sh tsx src/index.ts backfill-assertion-associations",
    "test": "../../scripts/with-env.sh tsx --test src/**/*.test.ts",
    "build": "../../scripts/with-env.sh tsc -p tsconfig.json",
    "typecheck": "../../scripts/with-env.sh tsc --noEmit"
  },
  "dependencies": {
    "@ocmc/db": "workspace:*",
    "@ocmc/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
