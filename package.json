{
  "name": "openclaw-mission-control",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:web": "scripts/with-env.sh pnpm --filter @ocmc/web dev",
    "dev:worker": "scripts/with-env.sh pnpm --filter @ocmc/worker dev",
    "deploy:web": "scripts/deploy-web.sh",
    "start:web": "scripts/with-env.sh pnpm --filter @ocmc/web start:local",
    "run:worker": "scripts/with-env.sh pnpm --filter @ocmc/worker start",
    "build": "scripts/with-env.sh pnpm -r build",
    "typecheck": "scripts/with-env.sh pnpm -r typecheck",
    "ci": "scripts/with-env.sh pnpm typecheck && scripts/with-env.sh pnpm build"
  }
}
